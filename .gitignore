# ---------------------------------------------------------------
# Digiwhiff RCS - SFMC Journey Builder Custom Activity (Node/Express)
# ---------------------------------------------------------------

# Dependencies
node_modules/
bower_components/
jspm_packages/

# Environment variables (secrets) - never commit
.env
.env.*
!.env.example
# Certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Runtime data generated by the app (e.g. data/rowid_counter.json)
data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches / alternate lockfiles (npm is used: package-lock.json)
.npm/
.yarn/
.pnpm-store/
yarn.lock
pnpm-lock.yaml
.eslintcache
*.tgz

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*~

# Build / coverage output
dist/
build/
out/
coverage/
.nyc_output/

# Postman exports (may contain tokens / credentials)
Documents/postman/
*.postman_environment.json
Interakt Public APIs Comsense.postman_collection*

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDEs and editors
.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.history/

# Visual Studio Code (keep shared workspace config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI tooling
.claude/
.code-review-graph/
